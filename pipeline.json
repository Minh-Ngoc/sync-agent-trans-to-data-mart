                              ]
                            }
                          ]
                        },
                        {
                          "$ifNull": [
                            "$$rule.baseAmount",
                            0
                          ]
                        }
                      ]
                    }
                  },
                  "in": {
                    "$let": {
                      "vars": {
                        "floorApplied": {
                          "$cond": [
                            {
                              "$ne": [
                                "$$rule.minAmount",
                                null
                              ]
                            },
                            {
                              "$max": [
                                "$$bonus",
                                "$$rule.minAmount"
                              ]
                            },
                            "$$bonus"
                          ]
                        }
                      },
                      "in": {
                        "$cond": [
                          {
                            "$ne": [
                              "$$rule.maxAmount",
                              null
                            ]
                          },
                          {
                            "$min": [
                              "$$floorApplied",
                              "$$rule.maxAmount"
                            ]
                          },
                          "$$floorApplied"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "bonus_out_amount": {
        "$let": {
