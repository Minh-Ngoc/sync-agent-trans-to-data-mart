                      "$add": [
                        {
                          "$multiply": [
                            {
                              "$abs": "$amount"
                            },
                            {
                              "$divide": [
                                {
                                  "$ifNull": [
                                    "$$rule.percent",
                                    0
                                  ]
                                },
                                100
                              ]
                            }
                          ]
                        },
                        {
                          "$ifNull": [
                            "$$rule.baseAmount",
